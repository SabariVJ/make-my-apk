<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The Health Connect client library declares minSdk 26 (Health Connect is
         an Android 8.0+ platform component). SVJ keeps minSdk 24 and only loads
         the plugin on API 26+, so devices below 26 never touch its classes. -->
    <uses-sdk tools:overrideLibrary="androidx.health.connect.client" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep link back from Google OAuth: app.lovable.svj://auth/callback -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="app.lovable.svj" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_app_id"/>

        <!-- SVJ's native activity recorder. A foreground service of type
             `location` is what keeps recording alive through screen lock and
             app backgrounding; it exists only while a workout is active. -->
        <service
            android:name=".VjWorkoutService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Smart local reminders. The receiver owns alarm delivery and
             restores repeating schedules after reboot, timezone change, clock
             correction, or app replacement. It is not exported to other apps. -->
        <receiver
            android:name=".VjNotificationReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Wear OS Data Layer: receives watch messages (handshake, live
             samples, session state, completed workout summaries) even when SVJ
             is not running, and buffers them for the app. -->
        <service
            android:name=".VjWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/svj/wear/" />
            </intent-filter>
        </service>

        <!-- Advertises the phone app to the SVJ Wear OS companion so the watch
             can find its phone node through capability discovery. -->
        <meta-data
            android:name="com.google.android.wearable.capability"
            android:value="svj_phone_app" />

        <!-- The phone is the companion host, not a standalone watch app. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <!-- Required Health Connect privacy/rationale declaration. Shown when the
             user asks why SVJ needs health data; it reuses SVJ's own privacy page
             via the app's existing deep-link scheme (app.lovable.svj://privacy). -->
        <activity
            android:name=".HealthPermissionsRationaleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+ routes the same rationale through VIEW_PERMISSION_USAGE. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".HealthPermissionsRationaleActivity">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- BLE wearable sensors: Android 12+ runtime permissions. Scan filters to
         the standard Heart Rate Service and never derives location from
         results, so neverScanForLocation is set; pre-Android-12 relies on the
         app's existing ACCESS_FINE_LOCATION. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <!-- Foreground-service location is enough to keep recording while the screen
         is locked, so SVJ does NOT request background location. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The phone is a Wear OS companion host, not a watch-only APK. Do not
         declare android.hardware.type.watch here: that feature is invalid in a
         phone manifest and Play applies it to the Wear OS module instead. -->

    <!-- Health Connect: lets the plugin detect/install the platform provider. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <!-- Health Connect READ-ONLY permissions, one per record type the plugin
         can read. SVJ never writes to Health Connect, so no WRITE permission
         is declared. No background health read is used either: imports happen
         only while the user is in the app, in the foreground. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />
</manifest>
