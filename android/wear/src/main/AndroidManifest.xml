<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- A Wear OS app: it is only offered to watches. -->
    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Optional hardware: the app reports what it actually has and never
         fabricates a metric the watch cannot measure. -->
    <uses-feature android:name="android.hardware.sensor.heartrate" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/WearAppTheme">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:taskAffinity=""
            android:theme="@style/WearAppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The watch workout keeps running while the screen is off or the user
             navigates away: a foreground service of type `health` with an
             ongoing indicator, which is the supported Wear OS mechanism. -->
        <service
            android:name=".WearWorkoutService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- Receives commands from the SVJ phone app over the Wear OS Data
             Layer (start/pause/resume/finish). -->
        <service
            android:name=".WearCommandListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/svj/wear/command" />
            </intent-filter>
        </service>

        <!-- Advertises the SVJ Wear OS companion so the phone can discover it
             by capability instead of Bluetooth-scanning the watch. -->
        <meta-data
            android:name="com.google.android.wearable.capability"
            android:value="svj_wear_companion" />

    </application>

    <!-- Heart rate: read from the watch's own sensor, only while an SVJ workout
         is recording. Nothing is collected outside a workout. -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
</manifest>
